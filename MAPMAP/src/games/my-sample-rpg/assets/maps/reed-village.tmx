    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="갈대 엮는 네아"/>
    <property name="type" value="character_villager_flower_dress"/>
    <property name="quest.hiddenWhenCompleted" value="q025-swamp-priest"/>
