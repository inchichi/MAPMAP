 <objectgroup id="2" name="characters">
  <!-- 사공 토빈, 촌장 미렌(c2-02 보고), 약초꾼 오디, 문지기 하르, 주민 둘 / 표지판 / 가라앉은 숲 문(닫힘) -->
  <object id="1" name="tobin" type="character" x="112" y="640" width="32" height="32">
   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="물길이 이렇게 불어난 건 처음이야. 노를 젓는 팔이 다 아프다니까."/>
     <item value="상류길 전망 둑으로 돌아가고 싶으면 나룻배에 타."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="사공 토빈"/>
    <property name="type" value="character_commoner_tan_tunic"/>
    <property name="quest.hiddenWhenCompleted" value="q025-swamp-priest"/>
   </properties>
  </object>
  <object id="60" name="tobin" type="character" x="112" y="640" width="32" height="32">
   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="물이 빠지니까 노 젓기가 한결 수월해. 상류길로 가는 배는 언제든 태워 줄게."/>
     <item value="요 며칠 수로에 물고기가 다시 올라와. 늪이 숨을 쉬는 거지."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="사공 토빈"/>
    <property name="type" value="character_commoner_tan_tunic"/>
    <property name="quest.requiresCompleted" value="q025-swamp-priest"/>
   </properties>
  </object>
  <object id="2" name="miren" type="character" x="688" y="672" width="32" height="32">
   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="갈대골은 가난해도 서로 돕고 사는 마을이라네."/>
     <item value="숲 쪽 일이라면 언제든 내게 묻게."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="촌장 미렌"/>
    <property name="type" value="character_elder_gray_hair"/>
    <property name="quest.hiddenWhenCompleted" value="q025-swamp-priest"/>
   </properties>
  </object>
  <object id="61" name="miren" type="character" x="688" y="672" width="32" height="32">
   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="사냥꾼들이 모두 돌아왔네. 이 늙은이가 무슨 말로 고마움을 다 전하겠나."/>
     <item value="갈대골 사람들은 자네 이름을 오래 기억할 걸세."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="촌장 미렌"/>
    <property name="type" value="character_elder_gray_hair"/>
    <property name="quest.requiresCompleted" value="q025-swamp-priest"/>
   </properties>
  </object>
  <object id="3" name="odi" type="character" x="1072" y="288" width="32" height="32">
   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="늪 약초는 독이 되기도 하고 약이 되기도 해요. 필요한 게 있으면 골라 보세요."/>
     <item value="독안개 냄새가 요즘 부쩍 짙어졌어요."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="약초꾼 오디"/>
    <property name="type" value="character_villager_flower_dress"/>
    <property name="quest.hiddenWhenCompleted" value="q025-swamp-priest"/>
   </properties>
  </object>
  <object id="62" name="odi" type="character" x="1072" y="288" width="32" height="32">
   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="독안개가 걷히니 숲에서 처음 보는 약초가 올라와요. 렌이랑 같이 캐러 가기로 했어요."/>
     <item value="해독 향이 남았으면 버리지 마세요. 언젠가 또 쓸 일이 있을지 몰라요."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="약초꾼 오디"/>
    <property name="type" value="character_villager_flower_dress"/>
    <property name="quest.requiresCompleted" value="q025-swamp-priest"/>
   </properties>
  </object>
  <object id="4" name="reed_guard" type="character" x="1296" y="832" width="32" height="32">
   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="저 문 너머가 가라앉은 숲이다. 숲길은 위험하다."/>
     <item value="촌장님 말씀을 듣고 가라. 개구리 녀석들이 떼로 다닌다."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="문지기 하르"/>
    <property name="type" value="character_villager_brown_tunic"/>
    <property name="quest.hiddenWhenCompleted" value="q025-swamp-priest"/>
   </properties>
  </object>
  <object id="63" name="reed_guard" type="character" x="1296" y="832" width="32" height="32">
   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="숲 문은 이제 열어 두었다. 개구리 녀석들도 순해져서 사람을 보면 물로 뛰어든다."/>
     <item value="그래도 밤 숲은 조심해라. 늪은 늪이다."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="문지기 하르"/>
    <property name="type" value="character_villager_brown_tunic"/>
    <property name="quest.requiresCompleted" value="q025-swamp-priest"/>
   </properties>
  </object>
