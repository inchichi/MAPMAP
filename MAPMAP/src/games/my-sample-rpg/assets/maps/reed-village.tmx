   <properties>
    <property name="blocksMovement" type="bool" value="true"/>
    <property name="controller.dialogueLines" type="list">
     <item value="잠겼던 갈대밭이 다시 드러났어. 올가을엔 지붕을 새로 일 수 있겠어."/>
     <item value="사냥꾼들 돌아온 날 밤엔 마을이 다 같이 모닥불을 피웠지."/>
    </property>
    <property name="controller.scriptId" value="vn-dialogue"/>
    <property name="displayText" value="갈대 엮는 네아"/>
